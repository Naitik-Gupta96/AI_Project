# Copy to .env (or export these) to point the providers at your model servers.

# vLLM OpenAI-compatible server, used by --provider vllm:<model>
VLLM_BASE_URL=http://localhost:8000/v1

# Ollama, used by --provider ollama:<model>
OLLAMA_HOST=http://localhost:11434

# Only for --provider openai:<model>@<url> against a server that needs a key
# OPENAI_API_KEY=

# Redis, only if you use the Redis store
# REDIS_URL=redis://localhost:6379/0
