{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reflection",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates", "lesson"],
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "prediction", "explanation", "confidence", "judgment", "rationale"],
        "properties": {
          "tag": {"type": "string", "enum": ["INIT", "RATIFY", "REVISE", "REFUTE", "REJECT"]},
          "prediction": {"type": "string", "minLength": 1},
          "explanation": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "judgment": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["prediction_matches", "explanation_agrees", "changed"],
                "properties": {
                  "prediction_matches": {"type": "boolean"},
                  "explanation_agrees": {"type": "boolean"},
                  "changed": {"type": "boolean"}
                }
              }
            ]
          },
          "rationale": {"type": "string"},
          "metadata": {"type": "object"}
        }
      }
    },
    "lesson": {"type": "string"}
  }
}
