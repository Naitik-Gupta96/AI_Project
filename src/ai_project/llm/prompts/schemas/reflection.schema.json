{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reflection",
  "description": "Alternatives to one past message, judged against the board as it was then.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates", "lesson"],
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prediction", "explanation", "confidence", "explanation_agrees", "prediction_matches", "changed", "rationale"],
        "properties": {
          "prediction": {"type": "string", "minLength": 1},
          "explanation": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "explanation_agrees": {"type": ["boolean", "null"]},
          "prediction_matches": {"type": ["boolean", "null"]},
          "changed": {"type": ["boolean", "null"]},
          "rationale": {"type": "string"}
        }
      }
    },
    "lesson": {"type": "string"}
  }
}
